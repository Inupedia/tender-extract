FROM python:3.12-slim

ARG SERVER_VERSION=dev

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    TENDER_SERVER_VERSION=${SERVER_VERSION} \
    TENDER_SERVER_CACHE_DIR=/data/cache \
    TENDER_SERVER_USE_OCR=false

WORKDIR /app

RUN groupadd --system app && useradd --system --gid app --create-home app

COPY pyproject.toml README.md ./
COPY src ./src

RUN python -m pip install --upgrade pip \
    && python -m pip install ".[server,pdf,docx]" \
    && mkdir -p /data/cache \
    && chown -R app:app /app /data

USER app

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=3).read()" || exit 1

CMD ["uvicorn", "tender_extract.server:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1", "--proxy-headers"]
